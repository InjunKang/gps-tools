# Cloudflare static-assets headers. The Content-Security-Policy itself is emitted per page
# as a <meta> tag by Astro (security.csp in astro.config.ts) so that it carries script/style hashes.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=()

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Sample files: make Safari on iOS offer them as downloads instead of rendering the XML.
/samples/*
  Content-Disposition: attachment
  Cache-Control: public, max-age=86400
