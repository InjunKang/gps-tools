---
// A <details> dropdown: works without JavaScript; the small script only closes it on outside
// click / Escape. hreflang links for search engines live in SeoHead, not here.
import { LOCALES, LOCALE_NAMES, type Locale } from '../config/site';
import { localePath, ui } from '../i18n';

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
---

<details class="langs" data-langs>
  <summary aria-label={`${ui[locale].language}: ${LOCALE_NAMES[locale]}`}>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3c2.8 3 2.8 15 0 18M12 3c-2.8 3-2.8 15 0 18" />
    </svg>
    <span>{LOCALE_NAMES[locale]}</span>
    <svg class="chevron" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
  </summary>
  <ul>
    {
      LOCALES.map((l) => (
        <li>
          <a href={localePath(l, slug)} hreflang={l} lang={l} aria-current={l === locale ? 'page' : undefined}>
            {LOCALE_NAMES[l]}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-langs]');
  if (menu) {
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') menu.open = false;
    });
  }
</script>

<style>
  .langs {
    position: relative;
    font-size: 0.9375rem;
  }
  summary {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.5rem;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    color: var(--text);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    border-color: var(--accent);
  }
  summary svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .langs[open] .chevron {
    transform: rotate(180deg);
  }
  ul {
    position: absolute;
    top: calc(100% + 0.375rem);
    right: 0;
    z-index: 10;
    min-width: 11rem;
    margin: 0;
    padding: 0.375rem;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.625rem;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
  }
  a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    color: var(--text);
    text-decoration: none;
  }
  a:hover {
    background: var(--accent-soft);
  }
  a[aria-current] {
    font-weight: 600;
    color: var(--accent);
  }
</style>
