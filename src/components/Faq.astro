---
import type { Locale } from '../config/site';
import type { Faq } from '../config/tools';
import { ui } from '../i18n';

interface Props {
  locale: Locale;
  items: Faq[];
}

const { locale, items } = Astro.props;
---

<section aria-labelledby="faq">
  <h2 id="faq">{ui[locale].faqHeading}</h2>
  {
    items.map(({ q, a }) => (
      <details>
        <summary>{q}</summary>
        <p>{a}</p>
      </details>
    ))
  }
</section>

<style>
  details {
    border-bottom: 1px solid var(--border);
  }
  summary {
    padding: 0.875rem 0;
    font-weight: 600;
    cursor: pointer;
  }
  p {
    margin: 0 0 1rem;
  }
</style>
